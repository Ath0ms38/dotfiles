# Nova runtime settings (not secrets — those live in secrets.env).
#
# Model: tool-calling quality matters more than raw size here. Groq free-tier
# models that support tools: openai/gpt-oss-120b, openai/gpt-oss-20b,
# llama-3.3-70b-versatile, llama-3.1-8b-instant, qwen/qwen3.6-27b.
# groq/compound has a much larger token budget but refuses tool schemas.
NOVA_MODEL=openai/gpt-oss-120b

# Wake word
NOVA_WAKE_THRESHOLD=0.5
NOVA_WAKE_VAD=0.4

# Quiet speech: lower NOVA_VAD_PROB to start recording more readily, raise
# NOVA_MIC_GAIN if the logs show a low peak percentage on your utterances.
NOVA_VAD_PROB=0.35
NOVA_MIC_GAIN=3.0

# Pause allowed inside one instruction before it is treated as finished.
NOVA_SILENCE=1.3

# Microphone: "default" follows the system default, which is the headset when
# it is on. It is released while the machine is idle (see hypridle.conf) so a
# wireless headset can reach its own power-off timer. A node name from
# `pactl list sources short` pins a specific one instead.
NOVA_MIC=default

# Speech: off | auto (only when asked) | always
NOVA_SPEAK=auto
NOVA_STT_MODEL=whisper-large-v3-turbo
