{
    "makefile.configureOnOpen": true,
    "kilo-code.allowedCommands": [
        "git log",
        "git diff",
        "git show",
        "npm test",
        "npm install",
        "tsc"
    ],
    "python.defaultInterpreterPath": "/sbin/python3.14",
    "github.copilot.nextEditSuggestions.enabled": true,
    "kilo-code.deniedCommands": [],
    "geminicodeassist.project": "neat-thought-htd9f",
    "claudeCode.selectedModel": "default",
    "claudeCode.preferredLocation": "panel",
    "redhat.telemetry.enabled": true,
    "containers.containerClient": "com.microsoft.visualstudio.containers.docker",
    "containers.orchestratorClient": "com.microsoft.visualstudio.orchestrators.dockercompose",
    "workbench.colorCustomizations": {
        "editor.background": "{{colors.background.default.hex}}",
        "editor.foreground": "{{colors.on_background.default.hex}}",
        "editorCursor.foreground": "{{colors.primary.default.hex}}",
        "editor.selectionBackground": "{{colors.primary.default.hex}}80",
        "editor.lineHighlightBackground": "{{colors.surface_container.default.hex}}",
        "activityBar.background": "{{colors.surface_container.default.hex}}",
        "activityBar.foreground": "{{colors.on_surface.default.hex}}",
        "activityBarBadge.background": "{{colors.primary.default.hex}}",
        "activityBarBadge.foreground": "{{colors.on_primary.default.hex}}",
        "sideBar.background": "{{colors.surface_container_low.default.hex}}",
        "sideBar.foreground": "{{colors.on_surface.default.hex}}",
        "statusBar.background": "{{colors.surface_container_high.default.hex}}",
        "statusBar.foreground": "{{colors.on_surface.default.hex}}",
        "titleBar.activeBackground": "{{colors.surface_container.default.hex}}",
        "titleBar.activeForeground": "{{colors.on_surface.default.hex}}",
        "tab.activeBackground": "{{colors.surface.default.hex}}",
        "tab.activeForeground": "{{colors.on_surface.default.hex}}",
        "tab.inactiveBackground": "{{colors.surface_container_low.default.hex}}",
        "tab.inactiveForeground": "{{colors.on_surface_variant.default.hex}}",
        "editorGroupHeader.tabsBackground": "{{colors.surface_container_low.default.hex}}",
        "panel.background": "{{colors.surface_container_lowest.default.hex}}",
        "panel.border": "{{colors.outline.default.hex}}",
        "terminal.background": "{{colors.background.default.hex}}",
        "terminal.foreground": "{{colors.on_background.default.hex}}",
        "button.background": "{{colors.primary.default.hex}}",
        "button.foreground": "{{colors.on_primary.default.hex}}",
        "input.background": "{{colors.surface_container_high.default.hex}}",
        "input.foreground": "{{colors.on_surface.default.hex}}",
        "input.border": "{{colors.outline.default.hex}}",
        "dropdown.background": "{{colors.surface_container_high.default.hex}}",
        "dropdown.foreground": "{{colors.on_surface.default.hex}}",
        "list.activeSelectionBackground": "{{colors.primary.default.hex}}40",
        "list.hoverBackground": "{{colors.surface_container.default.hex}}",
        "editorWidget.background": "{{colors.surface_container_high.default.hex}}",
        "editorError.foreground": "{{colors.error.default.hex}}",
        "editorWarning.foreground": "{{colors.yellow.default.hex}}",
        "gitDecoration.modifiedResourceForeground": "{{colors.yellow.default.hex}}",
        "gitDecoration.deletedResourceForeground": "{{colors.red.default.hex}}",
        "gitDecoration.untrackedResourceForeground": "{{colors.green.default.hex}}",
        "terminal.ansiBlack": "{{colors.shadow.default.hex}}",
        "terminal.ansiRed": "{{colors.red.default.hex}}",
        "terminal.ansiGreen": "{{colors.green.default.hex}}",
        "terminal.ansiYellow": "{{colors.yellow.default.hex}}",
        "terminal.ansiBlue": "{{colors.blue.default.hex}}",
        "terminal.ansiMagenta": "{{colors.magenta.default.hex}}",
        "terminal.ansiCyan": "{{colors.cyan.default.hex}}",
        "terminal.ansiWhite": "{{colors.on_background.default.hex}}",
        "terminal.ansiBrightBlack": "{{colors.outline.default.hex}}",
        "terminal.ansiBrightRed": "{{colors.red.default.hex | set_lightness: 10.0}}",
        "terminal.ansiBrightGreen": "{{colors.green.default.hex | set_lightness: 10.0}}",
        "terminal.ansiBrightYellow": "{{colors.yellow.default.hex | set_lightness: 10.0}}",
        "terminal.ansiBrightBlue": "{{colors.blue.default.hex | set_lightness: 10.0}}",
        "terminal.ansiBrightMagenta": "{{colors.magenta.default.hex | set_lightness: 10.0}}",
        "terminal.ansiBrightCyan": "{{colors.cyan.default.hex | set_lightness: 10.0}}",
        "terminal.ansiBrightWhite": "{{colors.white.default.hex}}",
        "editorBracketHighlight.foreground1": "{{colors.yellow.default.hex}}",
        "editorBracketHighlight.foreground2": "{{colors.magenta.default.hex}}",
        "editorBracketHighlight.foreground3": "{{colors.cyan.default.hex}}",
        "editorBracketHighlight.foreground4": "{{colors.green.default.hex}}"
    },
    "editor.tokenColorCustomizations": {
        "comments": "{{colors.on_surface_variant.default.hex}}",
        "strings": "{{colors.green.default.hex}}",
        "keywords": "{{colors.magenta.default.hex}}",
        "numbers": "{{colors.red.default.hex}}",
        "types": "{{colors.cyan.default.hex}}",
        "functions": "{{colors.tertiary.default.hex}}",
        "variables": "{{colors.blue.default.hex}}"
    }
}
