{
  "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
  "logo": {
    "source": "endeavour",
    "padding": {
      "top": 2,
      "left": 2,
      "right": 2
    }
  },
  "display": {
    "separator": "  ",
    "size": {
      "binaryPrefix": "iec"
    },
    "color": {
      "keys": "#92cef6",
      "title": "#ccc0e9",
      "separator": "#8b9198",
      "output": "#dfe3e7"
    }
  },
  "modules": [
    {
      "type": "custom",
      "outputColor": "#8b9198",
      "format": "╭──────────────────────────────────────────"
    },
    {
      "type": "title",
      "key": "│  ",
      "keyColor": "#8b9198",
      "format": "{user-name}@{host-name}",
      "color": {
        "user": "#ccc0e9",
        "at": "#8b9198",
        "host": "#b6c9d8"
      }
    },
    {
      "type": "custom",
      "outputColor": "#8b9198",
      "format": "├──────────────────────────────────────────"
    },
    {
      "type": "custom",
      "outputColor": "#92cef6",
      "format": "│    SYSTEM"
    },
    {
      "type": "os",
      "key": "│    ",
      "keyColor": "#8b9198",
      "format": "{pretty-name}"
    },
    {
      "type": "kernel",
      "key": "│   󰌽 ",
      "keyColor": "#8b9198",
      "format": "{release}"
    },
    {
      "type": "uptime",
      "key": "│   󰅐 ",
      "keyColor": "#8b9198"
    },
    {
      "type": "packages",
      "key": "│   󰏖 ",
      "keyColor": "#8b9198"
    },
    {
      "type": "custom",
      "outputColor": "#8b9198",
      "format": "│"
    },
    {
      "type": "custom",
      "outputColor": "#b6c9d8",
      "format": "│    DESKTOP"
    },
    {
      "type": "wm",
      "key": "│    ",
      "keyColor": "#8b9198"
    },
    {
      "type": "shell",
      "key": "│    ",
      "keyColor": "#8b9198"
    },
    {
      "type": "terminal",
      "key": "│    ",
      "keyColor": "#8b9198"
    },
    {
      "type": "font",
      "key": "│   󰛖 ",
      "keyColor": "#8b9198"
    },
    {
      "type": "custom",
      "outputColor": "#8b9198",
      "format": "│"
    },
    {
      "type": "custom",
      "outputColor": "#ccc0e9",
      "format": "│   󰍛 HARDWARE"
    },
    {
      "type": "cpu",
      "key": "│   󰻠 ",
      "keyColor": "#8b9198",
      "format": "{name}"
    },
    {
      "type": "gpu",
      "key": "│   󰢮 ",
      "keyColor": "#8b9198",
      "format": "{name}"
    },
    {
      "type": "memory",
      "key": "│   󰍛 ",
      "keyColor": "#8b9198"
    },
    {
      "type": "disk",
      "key": "│   󰋊 ",
      "keyColor": "#8b9198",
      "folders": "/"
    },
    {
      "type": "battery",
      "key": "│   󰁹 ",
      "keyColor": "#8b9198"
    },
    {
      "type": "custom",
      "outputColor": "#8b9198",
      "format": "├──────────────────────────────────────────"
    },
    {
      "type": "colors",
      "key": "│   ",
      "keyColor": "#8b9198",
      "symbol": "diamond"
    },
    {
      "type": "custom",
      "outputColor": "#8b9198",
      "format": "╰──────────────────────────────────────────"
    }
  ]
}
